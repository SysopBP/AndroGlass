<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.android.systemui" /></queries>
    <application android:label="@string/app_name" android:description="@string/module_description"
        android:icon="@drawable/ic_androglass" android:theme="@style/AppTheme"
        android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".ConfigProvider" android:authorities="app.androglass.config"
            android:exported="true" android:directBootAware="false" />
    </application>
</manifest>
